# ==============================================================================
# LLM Review-Insights Miner - Environment Configuration
# ==============================================================================
# Set your LLM API Key here. The pipeline supports OpenAI and Anthropic.
# If no key is set, the pipeline automatically falls back to an offline
# heuristic classifier so you can test end-to-end without incurring API costs.

# OpenAI API Key (e.g. gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (e.g. claude-3-5-haiku-latest or claude-3-haiku-20240307)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Model Selection: gpt-4o-mini | claude-3-5-haiku-latest
LLM_MODEL=gpt-4o-mini
